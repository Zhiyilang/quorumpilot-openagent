# Everything here is OPTIONAL. Without any of it the quorum still runs —
# four deterministic specialists, full verdicts, full receipts.

# Any OpenAI-compatible chat endpoint. Examples:
#   https://api.openai.com/v1
#   https://generativelanguage.googleapis.com/v1beta/openai   (Gemini)
#   http://your-ollama-host:11434/v1                            (Ollama)
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY=
OPENAI_MODEL=gemini-3-flash

# HTTP port for app.py
PORT=7860
